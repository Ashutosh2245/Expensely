# ===================================================
# EXPENSELY Frontend Production Environment Template
# ===================================================

# Render Backend API URL (must include /api prefix)
VITE_API_URL=https://expensely-api.onrender.com/api

# Render Backend Socket.io URL (root backend host)
VITE_SOCKET_URL=https://expensely-api.onrender.com

# Google OAuth 2.0 Client ID (Public Google Identity Services Web Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
