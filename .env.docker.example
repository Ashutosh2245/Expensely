# ==============================================================================
# EXPENSELY - Docker Compose Environment Configuration (.env.docker)
# Copy this file to .env.docker before running docker-compose:
#   cp .env.docker.example .env.docker
# ==============================================================================

# Backend Service Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database Configuration (Docker Compose service name 'mongodb')
MONGODB_URI=mongodb://mongodb:27017/expensely
# For MongoDB Atlas in production Docker, replace with:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expensely?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_expensely_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_expensely_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Optional for local Docker development)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Storage (Optional - falls back to local buffer if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=Expensely <noreply@expensely.com>

# Frontend Service Build Arguments / Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
