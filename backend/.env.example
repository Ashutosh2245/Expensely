# ===================================================
# EXPENSELY Backend Production Environment Template
# ===================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String (Required in Production)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expensely?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secrets (Generate strong random 64-char strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domain Configuration
FRONTEND_URL=https://expensely.vercel.app
BACKEND_URL=https://expensely-api.onrender.com

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://expensely-api.onrender.com/api/auth/google/callback

# Cloudinary Storage Credentials (Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Notification Credentials
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EXPENSELY <no-reply@expensely.app>
